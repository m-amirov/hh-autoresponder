# ============================================================
#  Конфигурация бота. Скопируй в .env и заполни свои значения.
#  Обязательны только TG_BOT_TOKEN, TG_ADMIN_CHAT_ID, HH_LOGIN, HH_PASSWORD.
# ============================================================

# ── Telegram (панель управления) ──────────────────────────
# Токен бота из @BotFather
TG_BOT_TOKEN=
# Твой числовой id из @userinfobot
TG_ADMIN_CHAT_ID=
# Прокси для Telegram, если из страны с блокировкой (опц.): socks5://user:pass@host:port
TG_PROXY=

# ── hh.ru ─────────────────────────────────────────────────
HH_LOGIN=
HH_PASSWORD=
# id резюме подставится автоматически при первом входе, оставь пустым
HH_RESUME_ID=

# ── Профиль и цель ────────────────────────────────────────
DESIRED_POSITION=Performance-маркетолог
DESIRED_SALARY_MIN=150000
DESIRED_SALARY_MAX=400000
RESUME_TEXT_PATH=configs/resume.txt

# ── Поисковые запросы (через запятую) ─────────────────────
SEARCH_QUERIES_RAW=performance маркетолог, интернет-маркетолог, директолог

# ── Скоринг вакансий (всё через запятую) ──────────────────
# TARGET_KEYWORDS — хотя бы одно слово в заголовке → вакансия подходит
TARGET_KEYWORDS_RAW=маркетолог, marketing, performance, трафик, seo, smm, директолог, таргетолог, ppc, digital
# NEGATIVE_KEYWORDS — слово в заголовке → вакансия отсеивается
NEGATIVE_KEYWORDS_RAW=junior, стажёр, стажер, intern, ассистент, помощник, продавец, менеджер по продажам
# STACK_KEYWORDS — каждое совпадение в тексте даёт бонус к баллу
STACK_KEYWORDS_RAW=performance, cpa, roi, drr, seo, smm, таргет, контекст, директ, google ads, аналитика, воронк, unit
# Вакансии с указанной ЗП ниже этого порога отсеиваются
SALARY_FLOOR=100000

# ── Сопроводительное письмо (одно на всех) ────────────────
COVER_LETTER=Добрый день! Заинтересовала ваша вакансия, у меня релевантный опыт, буду рад пообщаться.

# ── LLM (опционально: только для прохождения тестов работодателя) ──
# Без ключа базовые автоотклики работают. Ключ нужен, только если хочешь,
# чтобы ИИ отвечал на анкеты/тесты работодателя. polza.ai — OpenAI-совместимый.
AI_ENABLED=false
LLM_BASE_URL=https://api.polza.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash

# ── Темп / антибан ────────────────────────────────────────
CHECK_INTERVAL_SEC=300
BROWSER_HEADLESS=true
# Пауза между откликами, сек (низ/верх). 40–68 ≈ 200 откликов за 3 часа.
APPLY_DELAY_MIN=40
APPLY_DELAY_MAX=68
# Дневной лимит. 200 — потолок самого hh.
MAX_APPLIES_PER_DAY_HH=200

# ── Уведомления (тихие часы, МСК) ─────────────────────────
NOTIFY_HOUR_START=9
NOTIFY_HOUR_END=22
