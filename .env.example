# ============================================================
#  Конфигурация бота. Скопируй в .env и заполни свои значения.
#  Для безопасного режима нужны TG_BOT_TOKEN и TG_ADMIN_CHAT_ID.
#  Не заполняй логин/пароль hh.ru: для подбора вакансий они не нужны.
# ============================================================

# ── Telegram (панель управления) ──────────────────────────
# Токен бота из @BotFather
TG_BOT_TOKEN=
# Твой числовой id из @userinfobot
TG_ADMIN_CHAT_ID=
# Прокси для Telegram, если из страны с блокировкой (опц.): socks5://user:pass@host:port
TG_PROXY=

# ── Личный режим: только поиск и предпросмотр, без отправки ──
PREVIEW_ONLY=true

# ── hh.ru ─────────────────────────────────────────────────
HH_LOGIN=
HH_PASSWORD=
# Не нужен для режима предпросмотра. Автоопределение в исходном проекте не работает.
HH_RESUME_ID=

# ── Профиль и цель ────────────────────────────────────────
DESIRED_POSITION=Делопроизводитель / методист
DESIRED_SALARY_MIN=0
DESIRED_SALARY_MAX=0
RESUME_TEXT_PATH=configs/resume.txt

# ── Поисковые запросы (через запятую) ─────────────────────
SEARCH_QUERIES_RAW=делопроизводитель, методист, специалист по документообороту, специалист учебно-методического отдела
# Два независимых поисковых охвата: удалённые по РФ и любые по Перми.
SEARCH_REMOTE_RUSSIA=true
SEARCH_COUNTRY_AREA_ID=113
SEARCH_LOCAL_AREA_ENABLED=true
SEARCH_AREA_ID=72
SEARCH_PAGES_PER_QUERY=1
MIN_RELEVANCE_SCORE=60

# ── Скоринг вакансий (всё через запятую) ──────────────────
# TARGET_KEYWORDS — хотя бы одно слово в заголовке → вакансия подходит
TARGET_KEYWORDS_RAW=делопроизвод, методист, документооборот, учебно-методич
# NEGATIVE_KEYWORDS — слово в заголовке → вакансия отсеивается
NEGATIVE_KEYWORDS_RAW=
# STACK_KEYWORDS — каждое совпадение в тексте даёт бонус к баллу
STACK_KEYWORDS_RAW=
# Вакансии с указанной ЗП ниже этого порога отсеиваются
SALARY_FLOOR=0

# ── Сопроводительное письмо (одно на всех) ────────────────
COVER_LETTER=Здравствуйте! Меня заинтересовала ваша вакансия. Буду рад(а) обсудить требования и рассказать о своём опыте.

# ── LLM (опционально: только для прохождения тестов работодателя) ──
# Без ключа базовые автоотклики работают. Ключ нужен, только если хочешь,
# чтобы ИИ отвечал на анкеты/тесты работодателя. polza.ai — OpenAI-совместимый.
AI_ENABLED=false
LLM_BASE_URL=https://api.polza.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash

# ── Темп / антибан ────────────────────────────────────────
CHECK_INTERVAL_SEC=1800
BROWSER_HEADLESS=true
# Пауза между откликами, сек (низ/верх). 40–68 ≈ 200 откликов за 3 часа.
APPLY_DELAY_MIN=40
APPLY_DELAY_MAX=68
# В режиме PREVIEW_ONLY=true значение не используется.
MAX_APPLIES_PER_DAY_HH=5

# ── Уведомления (тихие часы, МСК) ─────────────────────────
NOTIFY_HOUR_START=9
NOTIFY_HOUR_END=22
